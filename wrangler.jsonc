{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "quickmail",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-06-01",
	"compatibility_flags": ["nodejs_compat", "enable_nodejs_http_modules"],
	"workers_dev": true,

	// Your Cloudflare account is picked up from `wrangler login`. If you belong
	// to more than one account, set CLOUDFLARE_ACCOUNT_ID in your environment
	// or uncomment this and paste the ID from the Cloudflare dashboard sidebar.
	// "account_id": "",

	// Deploys to <name>.<your-subdomain>.workers.dev out of the box. To serve it
	// from your own domain instead, uncomment this and make sure the zone is on
	// the same Cloudflare account.
	// "routes": [
	// 	{
	// 		"pattern": "mail.example.com",
	// 		"custom_domain": true
	// 	}
	// ],

	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},

	// Prefer `bun run setup` (or `bash scripts/setup.sh`) over editing this by hand.
	// Each direction is configured on its own — nothing is inferred:
	//   EMAIL_INBOUND  = who delivers incoming mail  (resend | cloudflare | none)
	//   EMAIL_OUTBOUND = who sends mail              (resend | cloudflare | none)
	// Empty or "none" turns that direction off (no receiving / no sending).
	// The Deploy button needs non-empty values, so use "none" there.
	// Mixed example — Resend sends, Cloudflare Email Routing receives:
	//   "EMAIL_INBOUND": "cloudflare", "EMAIL_OUTBOUND": "resend"
	// Resend secrets (when either direction is resend):
	//   wrangler secret put RESEND_API_KEY
	//   wrangler secret put RESEND_WEBHOOK_SECRET
	// Cloudflare needs CLOUDFLARE_MAIL_DOMAINS (and the send_email binding below
	// when EMAIL_OUTBOUND=cloudflare).
	// Locally, put values in .dev.vars (copy .dev.vars.example).
	"vars": {
		"EMAIL_INBOUND": "resend",
		"EMAIL_OUTBOUND": "resend",
		// Dashboard form requires a non-empty value. Keep example.com unless
		// Cloudflare is used in either direction; then use your domain.
		"CLOUDFLARE_MAIL_DOMAINS": "example.com"
	},

	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],

	// Workers AI, offered to admins as the instance's drafting provider. Unused
	// (and unbilled) until an admin picks it under Admin › AI drafting.
	"ai": {
		"binding": "AI",
		"remote": true
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "quickmail",
			// `bun run setup` fills this in, or: wrangler d1 create <name>
			"database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
			"migrations_dir": "migrations"
		}
	],

	// Attachments are stored in D1 by default, so no R2 bucket (and no payment
	// card) is needed. To keep large attachments in R2 instead, enable R2 on your
	// Cloudflare account, create a bucket, and uncomment:
	// "r2_buckets": [
	//   { "binding": "ATTACHMENTS", "bucket_name": "quickmail-attachments" }
	// ],

	"observability": {
		"enabled": true
	}
}
